{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CarlensApi": {
    "BaseUrl": "http://localhost:5200"
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "carlens:web:"
  },
